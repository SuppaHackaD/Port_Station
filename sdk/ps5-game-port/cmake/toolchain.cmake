# Windows-hosted PS5 native-title toolchain. Public dependencies remain pinned
# in tools/; no code or libraries from the supplied commercial dump are used.
get_filename_component(GP_WORKSPACE "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(GP_SDK_ROOT "${GP_WORKSPACE}/tools/sdk-v0.44/ps5-payload-sdk" CACHE PATH "Public payload SDK")
set(GP_LLVM "${GP_WORKSPACE}/tools/llvm-18.1.8/bin" CACHE PATH "LLVM host tools")
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_C_COMPILER "${GP_LLVM}/clang.exe")
set(CMAKE_CXX_COMPILER "${GP_LLVM}/clang++.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "${GP_LLVM}/llvm-ar.exe")
set(CMAKE_RANLIB "${GP_LLVM}/llvm-ranlib.exe")
set(CMAKE_SYSROOT "${GP_SDK_ROOT}/target")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_GP_COMMON "-fvisibility-nodllstorageclass=default -fno-stack-protector -fno-plt -femulated-tls -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_GP_COMMON} -isystem \"${GP_SDK_ROOT}/target/include\"")
# libc++ wrapper headers must precede the C headers for include_next to work.
set(CMAKE_CXX_FLAGS_INIT "${_GP_COMMON} -fno-exceptions -fno-rtti -nostdinc++ -isystem \"${GP_SDK_ROOT}/target/include/c++/v1\" -isystem \"${GP_SDK_ROOT}/target/include\"")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
